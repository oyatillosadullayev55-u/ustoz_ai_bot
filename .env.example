# Ushbu fayldan .env nusxa oling va o'z qiymatlaringizni yozing.
# .env faylini hech qachon GitHub'ga yoki boshqalarga yubormang.

# BotFather bergan token (namuna, o'zingiznikini yozing)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Admin Telegram ID raqamlari, vergul bilan ajratiladi.
# O'z ID'ingizni @userinfobot orqali bilib olishingiz mumkin.
ADMIN_IDS=

# Ma'lumotlar bazasi fayli (loyiha papkasiga nisbatan)
DATABASE_PATH=ustoz_ai.db

# Log darajasi: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Botning asosiy tili: uz, ru yoki en
DEFAULT_LANGUAGE=uz

# AI integratsiyasi (ixtiyoriy). Kalit bo'lmasa AI Ustoz dars bazasidan javob beradi.
# AI_ENABLED=true qiling va AI_API_KEY ga provayder kalitini yozing.
AI_ENABLED=false
AI_API_KEY=
# OpenAI bilan mos API manzili (OpenAI, OpenRouter, Groq va h.k.)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Javob kutish vaqti (soniya)
AI_TIMEOUT=30
# Bir foydalanuvchi uchun kunlik so'rov limiti
AI_DAILY_LIMIT=30
# Ikki so'rov orasidagi minimal tanaffus (soniya)
AI_MIN_INTERVAL=3
# Bitta javob uchun maksimal token soni
AI_MAX_TOKENS=700
# Suhbat tarixidan nechta oxirgi xabar yuboriladi
AI_HISTORY_LIMIT=8

# Kunlik eslatmalar: reja bajarilmagan foydalanuvchilarga eslatma yuborish.
# Vaqt O'zbekiston vaqti (UTC+5) bo'yicha ko'rsatiladi.
DAILY_REMINDERS_ENABLED=true
DAILY_REMINDER_HOUR=19
